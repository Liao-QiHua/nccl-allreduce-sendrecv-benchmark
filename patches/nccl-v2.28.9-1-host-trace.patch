diff --git a/src/include/host_trace.h b/src/include/host_trace.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/include/host_trace.h
@@ -0,0 +1,134 @@
+/*************************************************************************
+ * Host-only function timing for NCCL stage tracing.
+ *
+ * This file is disabled unless NCCL_ENABLE_HOST_TRACE=1 is set at build time
+ * and NCCL_HOST_TRACE=1 is set at runtime.
+ ************************************************************************/
+#ifndef NCCL_HOST_TRACE_H_
+#define NCCL_HOST_TRACE_H_
+
+#if defined(NCCL_ENABLE_HOST_TRACE)
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+namespace {
+
+static const unsigned NCCL_HOST_TRACE_CAPACITY = 32768;
+
+struct ncclHostTraceRecord {
+  const char* name;
+  uint64_t startNs;
+  uint64_t endNs;
+  uint64_t bytes;
+  int rank;
+  int pid;
+  long tid;
+};
+
+static ncclHostTraceRecord ncclHostTraceRecords[NCCL_HOST_TRACE_CAPACITY];
+static std::atomic<unsigned> ncclHostTraceCount(0);
+
+static uint64_t ncclHostTraceNowNs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+  return uint64_t(ts.tv_sec) * 1000000000ULL + uint64_t(ts.tv_nsec);
+}
+
+static bool ncclHostTraceEnabled() {
+  static const bool enabled = []() {
+    const char* value = std::getenv("NCCL_HOST_TRACE");
+    return value != nullptr && value[0] == '1';
+  }();
+  return enabled;
+}
+
+static uint64_t ncclHostTraceByteFilter() {
+  static const uint64_t bytes = []() {
+    const char* value = std::getenv("NCCL_HOST_TRACE_BYTES");
+    return value == nullptr ? 0ULL : uint64_t(std::strtoull(value, nullptr, 10));
+  }();
+  return bytes;
+}
+
+static void ncclHostTraceFlush() {
+  unsigned count = ncclHostTraceCount.load(std::memory_order_relaxed);
+  if (count > NCCL_HOST_TRACE_CAPACITY) count = NCCL_HOST_TRACE_CAPACITY;
+  if (count == 0) return;
+
+  const char* basePath = std::getenv("NCCL_HOST_TRACE_FILE");
+  if (basePath == nullptr || basePath[0] == '\0') basePath = "nccl_host_trace.csv";
+  char path[1024];
+  std::snprintf(path, sizeof(path), "%s.%d", basePath, int(getpid()));
+  FILE* file = std::fopen(path, "a");
+  if (file == nullptr) return;
+
+  if (std::ftell(file) == 0) {
+    std::fprintf(file, "event,rank,pid,tid,bytes,start_ns,end_ns,duration_ns\n");
+  }
+  for (unsigned i = 0; i < count; ++i) {
+    const ncclHostTraceRecord& record = ncclHostTraceRecords[i];
+    std::fprintf(file, "%s,%d,%d,%ld,%llu,%llu,%llu,%llu\n",
+        record.name, record.rank, record.pid, record.tid,
+        (unsigned long long)record.bytes,
+        (unsigned long long)record.startNs,
+        (unsigned long long)record.endNs,
+        (unsigned long long)(record.endNs - record.startNs));
+  }
+  std::fclose(file);
+}
+
+class ncclHostTraceScope {
+ public:
+  ncclHostTraceScope(const char* name, int rank, uint64_t bytes)
+      : name_(name), rank_(rank), bytes_(bytes), startNs_(0), enabled_(false) {
+    if (!ncclHostTraceEnabled()) return;
+    uint64_t filter = ncclHostTraceByteFilter();
+    if (filter != 0 && bytes_ != 0 && bytes_ != filter) return;
+    enabled_ = true;
+    startNs_ = ncclHostTraceNowNs();
+  }
+
+  ~ncclHostTraceScope() {
+    if (!enabled_) return;
+    uint64_t endNs = ncclHostTraceNowNs();
+    unsigned index = ncclHostTraceCount.fetch_add(1, std::memory_order_relaxed);
+    if (index >= NCCL_HOST_TRACE_CAPACITY) return;
+    ncclHostTraceRecords[index] = {
+      name_, startNs_, endNs, bytes_, rank_, int(getpid()), syscall(SYS_gettid)
+    };
+  }
+
+ private:
+  const char* name_;
+  int rank_;
+  uint64_t bytes_;
+  uint64_t startNs_;
+  bool enabled_;
+};
+
+struct ncclHostTraceAtExit {
+  ncclHostTraceAtExit() { std::atexit(ncclHostTraceFlush); }
+};
+
+static ncclHostTraceAtExit ncclHostTraceAtExitInstance;
+
+} // namespace
+
+#define NCCL_HOST_TRACE_JOIN_INNER(a, b) a##b
+#define NCCL_HOST_TRACE_JOIN(a, b) NCCL_HOST_TRACE_JOIN_INNER(a, b)
+#define NCCL_HOST_TRACE_SCOPE(name, rank, bytes) \
+  ncclHostTraceScope NCCL_HOST_TRACE_JOIN(ncclHostTraceScope_, __LINE__)(name, rank, bytes)
+
+#else
+
+#define NCCL_HOST_TRACE_SCOPE(name, rank, bytes) do { } while (0)
+
+#endif
+
+#endif
